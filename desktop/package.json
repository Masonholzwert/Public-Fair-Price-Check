{
  "name": "basic-lingo-desktop",
  "productName": "Basic Lingo",
  "version": "1.2.0",
  "description": "Basic Lingo for Mac and Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "web": "node build-web.js",
    "start": "npm run web && electron .",
    "mac": "npm run web && electron-builder --mac",
    "windows": "npm run web && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.basiclingo.desktop",
    "productName": "Basic Lingo",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../dist", "to": "web" }],
    "directories": { "output": "release" },
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }], "category": "public.app-category.education" },
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
