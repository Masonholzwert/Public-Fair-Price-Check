          "prompt": "Set the switches to RET (3 1 1).",
          "answer": 201,
          "explanation": "11 001 001."
        },
        {
          "id": "al13-l1-e5",
          "type": "multiple_choice",
          "prompt": "What do the lights show?",
          "code": [
            "076   ; 000: MVI A",
            "012   ;      10",
            "315   ; 002: CALL dbl",
            "010   ;      address 010 (low byte)",
            "000   ;      (high byte)",
            "323   ; 005: OUT 377",
            "377   ;      port 377",
            "166   ; 007: HLT",
            "207   ; 010: ADD A   ← dbl",
            "311   ; 011: RET"
          ],
          "options": [
            "20",
