        },
        {
          "id": "al4-l3-e6",
          "type": "find_bug",
          "prompt": "This program should show 4, but it shows 2. Which line is wrong?",
          "code": [
            "076   ; 000: MVI A",
            "003   ;      3",
            "075   ; 002: INR A",
            "323   ; 003: OUT 377",
            "377   ;      port 377",
            "166   ; 005: HLT"
