{
  "id": "al11",
  "title": "Rotating",
  "lessons": [
    {
      "id": "al11-l1",
      "title": "RLC and RRC",
      "xp": 15,
      "intro": [
        "RLC (007) rotates A one place to the left: every bit moves up, and bit 7 comes around to bit 0. RRC (017) rotates to the right, bit 0 coming around to bit 7.",
        "The bit that comes around also goes into the carry flag.",
        "Rotating one lit bit makes a running light, the classic Altair demo."
      ],
      "example": {
        "code": [
          "076   ; 000: MVI A",
          "001   ;      1",
          "006   ; 002: MVI B",
          "004   ;      4",
          "323   ; 004: OUT 377   ← loop",
          "377   ;      port 377",
          "007   ; 006: RLC",
          "005   ; 007: DCR B",
          "302   ; 010: JNZ loop",
          "004   ;      address 004 (low byte)",
          "000   ;      (high byte)",
          "166   ; 013: HLT"
        ],
        "output": [
          "LEDS ○○○○○○○● = 1",
          "LEDS ○○○○○○●○ = 2",
          "LEDS ○○○○○●○○ = 4",
          "LEDS ○○○○●○○○ = 8"
        ]
      },
      "exercises": [
        {
          "id": "al11-l1-e1",
          "type": "multiple_choice",
          "prompt": "What does RLC do with bit 7?",
          "options": [
            "Moves it around to bit 0 (and into the carry)",
