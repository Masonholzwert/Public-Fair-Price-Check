            "        printf(\"big\\n\");",
            "    else",
            "        printf(\"small\\n\");",
            "    return 0;",
            "}"
          ],
          "options": [
            "small",
            "big",
            "small big",
            "nothing"
          ],
          "answer": 0,
          "explanation": "7 is not greater than 10, so the else part runs."
        },
