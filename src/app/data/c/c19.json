          ],
          "answer": "<<",
          "explanation": "1 << 4 is 16, binary 10000."
        },
        {
          "id": "c19-l2-e5",
          "type": "multiple_choice",
          "prompt": "What is 5 ^ 5?",
          "options": [
            "0",
            "5",
            "10",
            "1"
          ],
          "answer": 0,
          "explanation": "XOR with itself clears every bit."
        },
        {
          "id": "c19-l2-e6",
          "type": "find_bug",
          "prompt": "This program prints 0, but it should print 1 (bit 2 of 13 is set). Which line is wrong?",
          "code": [
            "#include <stdio.h>",
            "",
            "int main() {",
            "    int n = 13;",
            "    printf(\"%d\\n\", n >> 2 && 0);",
            "    return 0;",
            "}"
          ],
          "answer": 4,
          "explanation": "&& 0 is always false. It should be (n >> 2) & 1, a bitwise AND."
        }
      ]
    },
    {
      "id": "c19-l3",
      "title": "Flags in One Number",
      "xp": 15,
      "intro": [
        "One int can hold many yes/no flags, one per bit. Unix does this for file permissions: read is 4, write is 2, execute is 1, so 6 means read and write.",
        "Set a flag with |=, test it with &, clear it with &= ~FLAG, and flip it with ^=.",
        "With #define names for the bits, the code reads almost like English: if (perm & WRITE) …"
      ],
      "example": {
        "code": [
          "#include <stdio.h>",
          "",
          "#define READ  4",
          "#define WRITE 2",
          "#define EXEC  1",
          "",
          "int main() {",
          "    int perm = READ | WRITE;",
          "    printf(\"%d\\n\", perm);",
          "    perm |= EXEC;",
          "    perm &= ~WRITE;",
          "    printf(\"%c%c%c\\n\", perm & READ ? 'r' : '-', perm & WRITE ? 'w' : '-', perm & EXEC ? 'x' : '-');",
          "    return 0;",
          "}"
        ],
        "output": [
          "6",
          "r-x"
        ]
      },
      "exercises": [
        {
          "id": "c19-l3-e1",
          "type": "multiple_choice",
          "prompt": "How do you turn the flag EXEC on?",
          "options": [
            "perm |= EXEC;",
            "perm &= EXEC;",
            "perm = EXEC;",
            "perm ^= ~EXEC;"
          ],
          "answer": 0,
          "explanation": "OR sets the bit and leaves the others alone."
        },
        {
          "id": "c19-l3-e2",
          "type": "multiple_choice",
          "prompt": "How do you check if WRITE is set?",
          "options": [
            "if (perm & WRITE)",
            "if (perm == WRITE)",
            "if (perm | WRITE)",
            "if (perm && WRITE)"
          ],
          "answer": 0,
          "explanation": "& keeps only that bit: nonzero means it's set."
        },
        {
          "id": "c19-l3-e3",
          "type": "fill_blank",
          "prompt": "Turn the WRITE flag off.",
          "code": [
            "    perm &= ___WRITE;"
          ],
          "options": [
            "~",
            "!",
            "-",
            "^"
          ],
          "answer": "~",
          "explanation": "~WRITE has every bit set except WRITE, so & clears just that one."
        },
