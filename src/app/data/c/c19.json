          "id": "c19-l2-e2",
          "type": "multiple_choice",
          "prompt": "What is 6 | 3?",
          "options": [
            "7",
            "2",
            "9",
            "5"
          ],
          "answer": 0,
          "explanation": "110 | 011 = 111 = 7."
        },
