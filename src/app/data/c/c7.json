          ],
          "answer": 0,
          "explanation": "(4 + 7) / 2.0 = 5.5, printed with one decimal."
        },
        {
          "id": "c7-l3-e5",
          "type": "multiple_choice",
          "prompt": "Why does average divide by 2.0 and not 2?",
          "options": [
            "To keep the decimals: 11 / 2 would be 5",
            "2.0 is faster",
            "To make it a void function",
            "It doesn't matter"
          ],
          "answer": 0,
          "explanation": "With 2.0, the division is done as a double."
        },
        {
          "id": "c7-l3-e6",
          "type": "multiple_choice",
          "prompt": "What happens in modern C if you call a function the compiler hasn't seen yet?",
          "options": [
            "An error or warning: implicit declaration",
            "It works perfectly",
            "The program crashes later",
            "The function is skipped"
          ],
          "answer": 0,
          "explanation": "Early C guessed that unknown functions return int. That caused so many bugs that modern C stopped guessing."
        }
      ]
    }
  ]
