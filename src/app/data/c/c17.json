        },
        {
          "id": "c17-l3-e5",
          "type": "find_bug",
          "prompt": "This loop uses freed memory. Which line is wrong?",
          "code": [
            "for (p = head; p != NULL; p = p->next)",
            "    free(p);"
          ],
          "answer": 0,
          "explanation": "p = p->next runs after free(p). Save next first."
        },
        {
          "id": "c17-l3-e6",
          "type": "multiple_choice",
          "prompt": "Why is inserting faster in a list than in an array?",
