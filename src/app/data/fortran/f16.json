            "IF (OK) GO TO 50",
            "IF (OK .EQ. 1) GO TO 50",
            "IF OK GO TO 50",
            "IF (OK = .TRUE.) GO TO 50"
          ],
          "answer": 0,
          "explanation": "A logical variable already is a condition."
        },
        {
          "id": "f16-l1-e5",
          "type": "find_bug",
          "prompt": "This deck stops with an error. Which card is wrong?",
          "code": [
            "      LOGICAL DONE",
