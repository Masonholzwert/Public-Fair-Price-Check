            "      WRITE (6,10) DONE",
            "   10 FORMAT (1X, I2)",
            "      END"
          ],
          "answer": 3,
          "explanation": "A logical value needs the L format, like L2."
        },
        {
          "id": "f16-l1-e6",
          "type": "multiple_choice",
          "prompt": "What is .NOT. .TRUE. .OR. .TRUE.?",
          "options": [
            ".TRUE.",
            ".FALSE.",
            "0",
            "an error"
          ],
          "answer": 0,
          "explanation": ".NOT. comes first: .FALSE. .OR. .TRUE. is .TRUE."
        }
      ]
    },
    {
      "id": "f16-l2",
      "title": "LOGICAL FUNCTION",
      "xp": 15,
      "intro": [
        "A function can give back a truth value: LOGICAL FUNCTION PRIME(N) answers a yes-or-no question. In the main program, declare the name as LOGICAL too, so FORTRAN knows what comes back.",
        "Inside, assign the result to the function's name, like any function: PRIME = .FALSE..",
        "IF (PRIME(N)) then reads almost like English. Questions like \"is it prime?\", \"is the card valid?\" or \"is the tank full?\" are perfect logical functions."
      ],
      "example": {
        "code": [
          "      LOGICAL PRIME",
          "      DO 10 N = 2, 20",
          "      IF (PRIME(N)) WRITE (6,20) N",
          "   10 CONTINUE",
          "   20 FORMAT (1X, I3)",
          "      STOP",
          "      END",
          "      LOGICAL FUNCTION PRIME(N)",
          "      PRIME = .TRUE.",
          "      DO 10 K = 2, N - 1",
          "      IF (MOD(N, K) .EQ. 0) PRIME = .FALSE.",
          "   10 CONTINUE",
          "      RETURN",
          "      END"
        ],
        "output": [
          "  2",
          "  3",
          "  5",
          "  7",
          " 11",
          " 13",
          " 17",
          " 19"
        ]
      },
      "exercises": [
        {
          "id": "f16-l2-e1",
          "type": "multiple_choice",
          "prompt": "What does LOGICAL FUNCTION PRIME(N) return?",
          "options": [
            ".TRUE. or .FALSE.",
            "A whole number",
            "A real number",
            "Nothing"
          ],
          "answer": 0,
          "explanation": "It answers a yes-or-no question."
        },
        {
          "id": "f16-l2-e2",
          "type": "multiple_choice",
          "prompt": "Why does the main program also say LOGICAL PRIME?",
          "options": [
            "So it knows PRIME gives back a logical value",
            "To call it twice",
            "It's a comment",
            "To make it faster"
          ],
          "answer": 0,
          "explanation": "Without it, PRIME would be REAL by the I–N rule."
        },
        {
          "id": "f16-l2-e3",
          "type": "fill_blank",
          "prompt": "Mark the number as not prime.",
          "code": [
            "      IF (MOD(N, K) .EQ. 0) PRIME = ___"
