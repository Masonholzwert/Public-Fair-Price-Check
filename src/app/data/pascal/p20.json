    {
      "id": "p20-l2",
      "title": "seek and filesize",
      "xp": 15,
      "intro": [
        "Every record in a typed file has the same size, so the computer can jump straight to record number n. seek(f, n) moves there; the first record is number 0.",
        "filesize(f) tells how many records there are, and filepos(f) where you are now. After read or write, the position moves one record on.",
        "To change a record, seek to it, read it, change it, seek back to it, and write it. That's random access, and it's why typed files were so useful for databases."
      ],
      "example": {
        "code": [
          "program Update;",
          "type",
          "  TBook = record",
          "    title: string[20];",
          "    year: integer;",
          "  end;",
          "var",
          "  f: file of TBook;",
          "  b: TBook;",
          "begin",
          "  assign(f, 'BOOKS.DAT');",
          "  rewrite(f);",
          "  b.title := 'Algorithms'; b.year := 1976; write(f, b);",
          "  b.title := 'Pascal Manual'; b.year := 1974; write(f, b);",
          "  b.title := 'Turbo Pascal'; b.year := 1983; write(f, b);",
          "  close(f);",
          "  reset(f);",
          "  writeln(filesize(f), ' books');",
          "  seek(f, 2);",
          "  read(f, b);",
          "  writeln('Record 2: ', b.title);",
          "  seek(f, 1);",
          "  read(f, b);",
          "  b.year := 1970;",
          "  seek(f, 1);",
          "  write(f, b);",
          "  seek(f, 0);",
          "  while not eof(f) do",
          "  begin",
          "    write(filepos(f), ' ');",
          "    read(f, b);",
          "    writeln(b.title, ' ', b.year);",
          "  end;",
          "  close(f);",
          "end."
        ],
        "output": []
      },
