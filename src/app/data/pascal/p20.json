    {
      "id": "p20-l3",
      "title": "A Small Database",
      "xp": 15,
      "intro": [
        "Put it together: a file of records is a small database. Adding a record means seeking to the end; searching means reading record by record until you find it.",
        "Keep the file open while you work with it, and close it at the end, so nothing is lost. On a floppy disk, every open and close took time.",
        "The example opens an existing stock file, adds an item, finds one by name and lowers its amount."
      ],
      "example": {
        "code": [
          "program Stock;",
          "type",
          "  TItem = record",
          "    name: string[10];",
          "    amount: integer;",
          "  end;",
          "  TStock = file of TItem;",
          "var",
          "  f: TStock;",
          "  it: TItem;",
          "  found: boolean;",
          "",
          "procedure Show(var f: TStock);",
          "var",
          "  it: TItem;",
          "begin",
          "  seek(f, 0);",
          "  while not eof(f) do",
          "  begin",
          "    read(f, it);",
          "    writeln(it.name:8, it.amount:4);",
          "  end;",
          "end;",
          "",
          "begin",
          "  assign(f, 'STOCK.DAT');",
          "  rewrite(f);",
          "  it.name := 'Floppy'; it.amount := 50; write(f, it);",
          "  it.name := 'Mouse'; it.amount := 4; write(f, it);",
          "  close(f);",
          "  ",
          "  reset(f);",
          "  seek(f, filesize(f));",
          "  it.name := 'Modem'; it.amount := 2; write(f, it);",
          "  seek(f, 0);",
          "  found := false;",
          "  while not eof(f) and not found do",
          "  begin",
          "    read(f, it);",
          "    if it.name = 'Floppy' then found := true;",
          "  end;",
          "  if found then",
          "  begin",
          "    it.amount := it.amount - 10;",
          "    seek(f, filepos(f) - 1);",
          "    write(f, it);",
          "  end;",
          "  Show(f);",
          "  close(f);",
          "end."
        ],
        "output": []
      },
