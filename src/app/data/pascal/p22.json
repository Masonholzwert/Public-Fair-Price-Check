          "prompt": "What does gotoxy(10, 5) do?",
          "options": [
            "Puts the cursor at column 10, row 5",
            "Puts it at row 10, column 5",
            "Writes 10 and 5",
            "Clears 5 rows"
          ],
          "answer": 0,
          "explanation": "x first (across), then y (down)."
        },
