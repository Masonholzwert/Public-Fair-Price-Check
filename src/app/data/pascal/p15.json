    {
      "id": "p15-l2",
      "title": "+, * and -",
      "xp": 15,
      "intro": [
        "Sets can be combined: a + b has everything that's in a or b (union), a * b only what's in both (intersection), a - b what's in a but not in b (difference).",
        "include(s, x) adds one value, exclude(s, x) removes one. [] is the empty set.",
        "a = b compares two sets, a <= b checks if a is part of b."
      ],
      "example": {
        "code": [
          "program Toppings;",
          "type",
          "  TTopping = (cheese, ham, mushrooms, olives);",
          "const",
          "  name: array[TTopping] of string = ('cheese', 'ham', 'mushrooms', 'olives');",
          "var",
          "  ann, ben, both, any: set of TTopping;",
          "  t: TTopping;",
          "begin",
          "  ann := [cheese, ham, olives];",
          "  ben := [cheese, mushrooms];",
          "  both := ann * ben;",
          "  any := ann + ben;",
          "  for t := cheese to olives do",
          "  begin",
          "    if t in both then writeln(name[t], ': both like it')",
          "    else if t in any then writeln(name[t], ': one likes it');",
          "  end;",
          "  exclude(ann, ham);",
          "  if ann <= [cheese, olives] then",
          "    writeln('Ann eats no ham now');",
          "end."
        ],
        "output": []
      },
      "exercises": [
        {
          "id": "p15-l2-e1",
          "type": "multiple_choice",
          "prompt": "What is ['a', 'b'] + ['b', 'c']?",
          "options": [
            "['a', 'b', 'c']",
            "['b']",
            "['a']",
            "['a', 'b', 'b', 'c']"
          ],
          "answer": 0,
          "explanation": "Union: everything in either set (each value only once)."
        },
        {
          "id": "p15-l2-e2",
          "type": "multiple_choice",
          "prompt": "What is ['a', 'b'] * ['b', 'c']?",
          "options": [
            "['b']",
            "['a', 'b', 'c']",
            "['a', 'c']",
            "[]"
          ],
          "answer": 0,
          "explanation": "Intersection: only what's in both."
        },
