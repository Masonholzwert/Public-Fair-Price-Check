    },
    {
      "id": "p18-l3",
      "title": "eof",
      "xp": 15,
      "intro": [
        "eof(f) (end of file) is true when everything has been read. while not eof(f) do readln(f, line); reads a whole file, however long it is.",
        "append(f) opens an existing file to add lines at the end.",
        "Programs on the PC saved settings, high scores and documents exactly like this."
      ],
      "example": {
        "code": [
          "program All;",
          "var",
          "  f: text;",
          "  line: string;",
          "  n: integer;",
          "begin",
          "  assign(f, 'SCORES.TXT');",
          "  append(f);",
          "  writeln(f, 'BOB 81');",
          "  close(f);",
          "  reset(f);",
          "  n := 0;",
          "  while not eof(f) do",
          "  begin",
          "    readln(f, line);",
          "    n := n + 1;",
          "    writeln(n, ': ', line);",
          "  end;",
          "  close(f);",
          "end."
        ],
        "output": [
          "1: ADA 92",
          "2: KEN 78",
          "3: NIKLAUS 99",
          "4: BOB 81"
        ]
      },
      "exercises": [
        {
          "id": "p18-l3-e1",
          "type": "multiple_choice",
          "prompt": "What does eof(f) tell you?",
          "options": [
            "Whether everything in the file has been read",
            "Whether the file exists",
            "The file's size",
            "The last line"
          ],
          "answer": 0,
          "explanation": "End Of File."
        },
        {
          "id": "p18-l3-e2",
          "type": "fill_blank",
