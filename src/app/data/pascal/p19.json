          "type": "order_lines",
          "prompt": "Put the parts of a unit in order.",
          "lines": [
            "unit Tools;",
            "interface",
            "procedure Beep;",
            "implementation",
            "procedure Beep; begin write(#7) end;",
            "end."
          ],
          "answer": [
