        }
      ]
    },
    {
      "id": "p19-l3",
      "title": "Starting Up a Unit",
      "xp": 15,
      "intro": [
        "A unit can end with begin … end. instead of just end. Those statements run once, before the program's own begin: the unit's initialization. It's the place to set variables to their first values.",
        "Borland's own units worked like this: crt found out what kind of screen the PC had before your program started. Other standard units were dos (files and the clock) and printer.",
        "If several units are used, their initializations run in order, and then the program starts."
      ],
      "example": {
        "code": [
          "unit Log;",
          "",
          "interface",
          "",
          "procedure Note(s: string);",
          "",
          "implementation",
          "",
          "var",
          "  lines: integer;",
          "",
          "procedure Note(s: string);",
          "begin",
          "  lines := lines + 1;",
          "  writeln(lines, ': ', s);",
          "end;",
          "",
          "begin",
          "  lines := 0;",
          "  writeln('--- log started ---');",
          "end.",
          "",
          "program Diary;",
          "uses Log;",
          "begin",
          "  writeln('Hello from the program');",
          "  Note('woke up');",
          "  Note('wrote Pascal');",
          "end."
        ],
        "output": [
          "--- log started ---",
          "Hello from the program",
          "1: woke up",
          "2: wrote Pascal"
        ]
      },
      "exercises": [
        {
          "id": "p19-l3-e1",
          "type": "multiple_choice",
          "prompt": "When does a unit's begin … end. part run?",
          "options": [
