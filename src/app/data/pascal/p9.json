{
  "id": "p9",
  "title": "Recursion",
  "lessons": [
    {
      "id": "p9-l1",
      "title": "A Routine That Calls Itself",
      "xp": 15,
      "intro": [
        "A routine may call itself. That's called recursion. Each call gets its own fresh copy of the parameters and local variables.",
        "Every recursive routine needs a base case where it stops calling itself. Without one, it calls itself until memory runs out: Runtime error 202: Stack overflow.",
        "Recursion fits problems that contain smaller versions of themselves."
      ],
      "example": {
        "code": [
          "program Rec;",
          "",
          "procedure Countdown(n: integer);",
          "begin",
          "  if n = 0 then",
          "    writeln('Liftoff!')",
          "  else",
          "  begin",
          "    write(n, ' ');",
          "    Countdown(n - 1);",
          "  end;",
          "end;",
          "",
          "begin",
          "  Countdown(5);",
          "end."
        ],
        "output": [
          "5 4 3 2 1 Liftoff!"
        ]
      },
      "exercises": [
        {
          "id": "p9-l1-e1",
          "type": "multiple_choice",
          "prompt": "What is recursion?",
          "options": [
            "A routine that calls itself",
            "A loop with for",
            "A routine with many parameters",
            "A global variable"
          ],
          "answer": 0,
          "explanation": "Each call works on a smaller version of the problem."
        },
        {
          "id": "p9-l1-e2",
          "type": "multiple_choice",
          "prompt": "What is the base case?",
          "options": [
            "The case where the routine stops calling itself",
            "The first line of the program",
            "The main program",
            "A case statement"
          ],
          "answer": 0,
          "explanation": "Without it, the recursion never ends."
        },
        {
          "id": "p9-l1-e3",
          "type": "multiple_choice",
          "prompt": "What happens if the base case is missing?",
          "options": [
            "Runtime error 202: Stack overflow",
            "The program ends normally",
            "It prints nothing",
            "Error 85"
          ],
          "answer": 0,
          "explanation": "Every call uses some memory on the stack, until it's full."
        },
        {
          "id": "p9-l1-e4",
          "type": "multiple_choice",
          "prompt": "What does this program print?",
          "code": [
            "program C;",
            "",
            "procedure Down(n: integer);",
            "begin",
            "  if n > 0 then",
            "  begin",
            "    write(n, ' ');",
            "    Down(n - 1);",
            "  end;",
            "end;",
            "",
            "begin",
            "  Down(3);",
            "  writeln;",
            "end."
          ],
          "options": [
            "3 2 1 ",
            "1 2 3 ",
            "3",
            "an error"
          ],
          "answer": 0,
          "explanation": "It prints n, then calls itself with n - 1, until n is 0."
        },
        {
          "id": "p9-l1-e5",
          "type": "multiple_choice",
          "prompt": "What does this program print?",
          "code": [
            "program C2;",
            "",
            "procedure Up(n: integer);",
            "begin",
            "  if n > 0 then",
            "  begin",
            "    Up(n - 1);",
            "    write(n, ' ');",
            "  end;",
            "end;",
            "",
            "begin",
            "  Up(3);",
            "  writeln;",
            "end."
          ],
          "options": [
            "1 2 3 ",
            "3 2 1 ",
            "3",
            "nothing"
          ],
          "answer": 0,
          "explanation": "Here the write comes after the recursive call, so the numbers come out on the way back."
        },
        {
          "id": "p9-l1-e6",
          "type": "find_bug",
          "prompt": "This procedure never stops. Which line is wrong?",
          "code": [
            "procedure Down(n: integer);",
            "begin",
            "  if n > 0 then",
            "  begin",
            "    write(n, ' ');",
            "    Down(n);",
            "  end;",
            "end;"
          ],
          "answer": 5,
          "explanation": "The call must make the problem smaller: Down(n - 1)."
        }
      ]
    },
    {
      "id": "p9-l2",
      "title": "Factorials and Powers",
      "xp": 15,
      "intro": [
        "The factorial n! = 1 × 2 × … × n has a recursive definition: 0! is 1, and n! is n × (n - 1)!. That turns straight into a function.",
        "Factorials grow fast: 8! = 40320 is already too big for an integer. Use longint for the result.",
        "Powers work the same way: x^0 is 1, and x^n is x × x^(n - 1)."
      ],
      "example": {
        "code": [
          "program Fact;",
          "var",
          "  i: integer;",
          "",
          "function Factorial(n: integer): longint;",
          "begin",
          "  if n = 0 then",
          "    Factorial := 1",
          "  else",
          "    Factorial := n * Factorial(n - 1);",
          "end;",
          "",
          "function Power(x, n: integer): longint;",
          "begin",
          "  if n = 0 then",
          "    Power := 1",
          "  else",
          "    Power := x * Power(x, n - 1);",
          "end;",
          "",
          "begin",
          "  for i := 0 to 8 do",
          "    writeln(i, '! = ', Factorial(i));",
          "  writeln('2^10 = ', Power(2, 10));",
          "end."
        ],
        "output": [
          "0! = 1",
          "1! = 1",
          "2! = 2",
          "3! = 6",
          "4! = 24",
          "5! = 120",
          "6! = 720",
          "7! = 5040",
          "8! = 40320",
          "2^10 = 1024"
        ]
      },
      "exercises": [
        {
          "id": "p9-l2-e1",
          "type": "multiple_choice",
          "prompt": "What is 4!?",
          "options": [
            "24",
            "10",
            "16",
            "4"
          ],
          "answer": 0,
          "explanation": "1 × 2 × 3 × 4."
        },
        {
          "id": "p9-l2-e2",
          "type": "multiple_choice",
          "prompt": "Why does Factorial return a longint?",
          "options": [
            "Factorials quickly get bigger than 32767",
            "Functions must return longint",
            "It's faster",
            "For negative numbers"
          ],
          "answer": 0,
          "explanation": "8! is 40320 already."
        },
        {
          "id": "p9-l2-e3",
          "type": "fill_blank",
          "prompt": "Finish the recursive step.",
          "code": [
            "    Factorial := n * ___(n - 1);"
          ],
          "options": [
            "Factorial",
            "n",
            "Power",
            "Recall"
          ],
          "answer": "Factorial",
          "explanation": "The function calls itself with a smaller n."
        },
        {
          "id": "p9-l2-e4",
          "type": "multiple_choice",
          "prompt": "What does this program print?",
          "code": [
            "program P;",
            "",
            "function Power(x, n: integer): longint;",
            "begin",
            "  if n = 0 then",
            "    Power := 1",
            "  else",
            "    Power := x * Power(x, n - 1);",
            "end;",
            "",
            "begin",
            "  writeln(Power(3, 3));",
            "end."
          ],
          "options": [
            "27",
            "9",
            "6",
            "81"
          ],
          "answer": 0,
          "explanation": "3 × 3 × 3."
        },
        {
          "id": "p9-l2-e5",
          "type": "multiple_choice",
          "prompt": "How many times is Factorial called for Factorial(3)?",
          "options": [
            "4 (for 3, 2, 1 and 0)",
            "3",
            "1",
            "6"
          ],
          "answer": 0,
          "explanation": "Each call goes one step lower until 0."
        },
        {
          "id": "p9-l2-e6",
          "type": "find_bug",
          "prompt": "This function crashes with a stack overflow. Which line is wrong?",
          "code": [
            "function Sum(n: integer): integer;",
            "begin",
            "  if n = 1 then",
            "    Sum := 1",
            "  else",
            "    Sum := n + Sum(n + 1);",
            "end;"
          ],
          "answer": 5,
          "explanation": "The call must move towards the base case: Sum(n - 1)."
        }
      ]
    },
    {
      "id": "p9-l3",
      "title": "Nested Routines",
      "xp": 15,
      "intro": [
        "In Pascal, a routine can contain its own routines, declared between its header and its begin. A nested routine can see the outer routine's parameters and variables.",
        "That keeps helper routines private: nobody outside can call them by mistake. C doesn't have this, but Pascal does.",
        "Two routines that call each other need forward: the first one is announced before the second is written."
      ],
      "example": {
        "code": [
          "program Nest;",
          "",
          "procedure Report(name: string; score: integer);",
          "",
          "  procedure Stars;",
          "  var",
          "    i: integer;",
          "  begin",
          "    for i := 1 to score div 10 do",
          "      write('*');",
          "    writeln;",
          "  end;",
          "",
          "begin",
          "  write(name, ': ');",
          "  Stars;",
          "end;",
          "",
          "begin",
          "  Report('Ada', 90);",
          "  Report('Ken', 60);",
          "end."
        ],
        "output": [
          "Ada: *********",
          "Ken: ******"
        ]
      },
      "exercises": [
        {
          "id": "p9-l3-e1",
          "type": "multiple_choice",
          "prompt": "Where is a nested routine declared?",
          "options": [
            "Between the outer routine's header and its begin",
            "After end.",
            "Inside the main begin",
            "In a separate file"
          ],
          "answer": 0,
          "explanation": "Just like local variables."
        },
        {
          "id": "p9-l3-e2",
          "type": "multiple_choice",
          "prompt": "Which variables can a nested routine see?",
          "options": [
            "Its own, the outer routine's, and the globals",
            "Only its own",
            "Only globals",
            "None"
          ],
          "answer": 0,
          "explanation": "Stars uses score from Report."
        },
        {
          "id": "p9-l3-e3",
          "type": "multiple_choice",
          "prompt": "Can the main program call a routine that is nested inside another one?",
          "options": [
            "No, it's private to the outer routine",
            "Yes, always",
            "Only with forward",
            "Only if it has no parameters"
          ],
          "answer": 0,
          "explanation": "That's the point of nesting."
        },
        {
          "id": "p9-l3-e4",
          "type": "fill_blank",
          "prompt": "Announce a routine that is written further down.",
          "code": [
            "function IsOdd(n: integer): boolean; ___;"
          ],
          "options": [
            "forward",
            "extern",
            "later",
            "declare"
          ],
          "answer": "forward",
          "explanation": "forward tells the compiler the body comes later."
        },
        {
          "id": "p9-l3-e5",
          "type": "multiple_choice",
          "prompt": "What does this program print?",
          "code": [
            "program N;",
            "",
            "procedure Show(name: string; n: integer);",
            "  procedure Stars;",
            "  var i: integer;",
            "  begin",
            "    for i := 1 to n do write('*');",
            "  end;",
            "begin",
            "  write(name, ': ');",
            "  Stars;",
            "  writeln;",
            "end;",
            "",
            "begin",
            "  Show('Ada', 5);",
            "end."
          ],
          "options": [
            "Ada: *****",
            "Ada: 5",
            "*****",
            "an error"
          ],
          "answer": 0,
          "explanation": "Stars uses the outer parameter n."
        },
        {
          "id": "p9-l3-e6",
          "type": "multiple_choice",
          "prompt": "Which language doesn't have nested functions?",
          "options": [
            "C",
            "Pascal",
            "Turbo Pascal",
            "Delphi"
          ],
          "answer": 0,
          "explanation": "In C, all functions are on the same level."
        }
      ]
    }
  ]
