    {
      "id": "p21-l2",
      "title": "Searching a Tree",
      "xp": 15,
      "intro": [
        "To find a key, start at the root and go left or right, just like inserting. Each step leaves out a whole subtree.",
        "In a balanced tree of 1,000 keys, that's about 10 steps. A linked list would need up to 1,000.",
        "The height (the longest path down) decides the worst case. If the keys come in already sorted, every node goes right, and the tree is no better than a list."
      ],
      "example": {
        "code": [
          "program Search;",
          "type",
          "  PTree = ^TTree;",
          "  TTree = record",
          "    key: integer;",
          "    left, right: PTree;",
          "  end;",
          "const",
          "  mixed: array[1..7] of integer = (4, 2, 6, 1, 3, 5, 7);",
          "var",
          "  a, b: PTree;",
          "  i: integer;",
          "",
          "procedure Insert(var t: PTree; k: integer);",
          "begin",
          "  if t = nil then",
          "  begin",
          "    new(t);",
          "    t^.key := k;",
          "    t^.left := nil;",
          "    t^.right := nil;",
          "  end",
          "  else if k < t^.key then Insert(t^.left, k)",
          "  else Insert(t^.right, k);",
          "end;",
          "",
          "function Find(t: PTree; k: integer): boolean;",
          "begin",
          "  while (t <> nil) and (t^.key <> k) do",
          "    if k < t^.key then t := t^.left else t := t^.right;",
          "  Find := t <> nil;",
          "end;",
          "",
          "function Height(t: PTree): integer;",
          "var",
          "  l, r: integer;",
          "begin",
          "  if t = nil then Height := 0",
          "  else",
          "  begin",
          "    l := Height(t^.left);",
          "    r := Height(t^.right);",
          "    if l > r then Height := l + 1 else Height := r + 1;",
          "  end;",
          "end;",
          "",
          "",
          "begin",
          "  a := nil;",
          "  b := nil;",
          "  for i := 1 to 7 do",
          "  begin",
          "    Insert(a, mixed[i]);",
          "    Insert(b, i);",
          "  end;",
          "  writeln('Find 5: ', Find(a, 5));",
          "  writeln('Find 9: ', Find(a, 9));",
          "  writeln('Heights: ', Height(a), ' and ', Height(b));",
          "end."
        ],
        "output": []
      },
