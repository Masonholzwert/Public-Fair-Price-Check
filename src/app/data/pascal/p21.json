    {
      "id": "p21-l3",
      "title": "Disposing a Tree",
      "xp": 15,
      "intro": [
        "Every node came from new, so every node must go back with dispose. But after dispose(t), t^.left can't be used anymore.",
        "So dispose the children first and the node last: left subtree, right subtree, node. That order is called post-order.",
        "Counting nodes or adding up the keys follow the same recursive pattern: the result for the left subtree, plus the node, plus the result for the right subtree."
      ],
      "example": {
        "code": [
          "program Clean;",
          "type",
          "  PTree = ^TTree;",
          "  TTree = record",
          "    key: integer;",
          "    left, right: PTree;",
          "  end;",
          "var",
          "  root: PTree;",
          "",
          "procedure Insert(var t: PTree; k: integer);",
          "begin",
          "  if t = nil then",
          "  begin",
          "    new(t);",
          "    t^.key := k;",
          "    t^.left := nil;",
          "    t^.right := nil;",
          "  end",
          "  else if k < t^.key then Insert(t^.left, k)",
          "  else Insert(t^.right, k);",
          "end;",
          "",
          "function Count(t: PTree): integer;",
          "begin",
          "  if t = nil then Count := 0",
          "  else Count := Count(t^.left) + 1 + Count(t^.right);",
          "end;",
          "",
          "procedure DisposeTree(var t: PTree);",
          "begin",
          "  if t <> nil then",
          "  begin",
          "    DisposeTree(t^.left);",
          "    DisposeTree(t^.right);",
          "    writeln('dispose ', t^.key);",
          "    dispose(t);",
          "    t := nil;",
          "  end;",
          "end;",
          "",
          "",
          "begin",
          "  root := nil;",
          "  Insert(root, 2);",
          "  Insert(root, 1);",
          "  Insert(root, 3);",
          "  writeln(Count(root), ' nodes');",
          "  DisposeTree(root);",
          "  writeln(Count(root), ' nodes left');",
          "end."
        ],
        "output": []
      },
      "exercises": [
        {
          "id": "p21-l3-e1",
          "type": "multiple_choice",
          "prompt": "Why dispose the children before the node?",
          "options": [
            "After dispose(t), t^.left and t^.right can't be used",
