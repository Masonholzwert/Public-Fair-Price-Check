{
  "id": "p21",
  "title": "Binary Trees",
  "lessons": [
    {
      "id": "p21-l1",
      "title": "Tree Nodes",
      "xp": 15,
      "intro": [
        "A list node has one pointer to the next node. A tree node has two: left and right. In a binary search tree, smaller keys go to the left and bigger ones to the right, at every node.",
        "Insert is recursive: if the tree is empty (nil), make a new node there. Otherwise go left or right and insert into that smaller tree. Because t is a var parameter, the new node is linked in automatically.",
        "Visiting left, then the node, then right (in order) shows all keys sorted. Niklaus Wirth's famous book was called Algorithms + Data Structures = Programs, and trees were a big part of it."
      ],
      "example": {
        "code": [
          "program Tree;",
          "type",
          "  PTree = ^TTree;",
          "  TTree = record",
          "    key: integer;",
          "    left, right: PTree;",
          "  end;",
          "const",
          "  keys: array[1..7] of integer = (50, 30, 70, 20, 40, 60, 80);",
          "var",
          "  root: PTree;",
          "  i: integer;",
          "",
          "procedure Insert(var t: PTree; k: integer);",
          "begin",
          "  if t = nil then",
          "  begin",
          "    new(t);",
          "    t^.key := k;",
          "    t^.left := nil;",
          "    t^.right := nil;",
          "  end",
          "  else if k < t^.key then Insert(t^.left, k)",
          "  else Insert(t^.right, k);",
          "end;",
          "",
          "procedure InOrder(t: PTree);",
          "begin",
          "  if t <> nil then",
          "  begin",
          "    InOrder(t^.left);",
          "    write(t^.key, ' ');",
          "    InOrder(t^.right);",
          "  end;",
          "end;",
          "",
          "",
          "begin",
          "  root := nil;",
          "  for i := 1 to 7 do",
          "    Insert(root, keys[i]);",
          "  InOrder(root);",
          "  writeln;",
          "end."
        ],
        "output": []
      },
      "exercises": [
