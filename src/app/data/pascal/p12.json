    },
    {
      "id": "p12-l3",
      "title": "Binary Search",
      "xp": 15,
      "intro": [
        "In a sorted array, there's a much faster way: look at the middle element. If the wanted value is smaller, it can only be in the left half; if bigger, in the right half. Repeat with that half.",
        "Each step throws away half of what's left, so 1000 elements need only about 10 steps. That's binary search, like looking up a word in a dictionary.",
        "It only works if the array is sorted!"
      ],
      "example": {
        "code": [
          "program Binary;",
          "type",
          "  TList = array[1..8] of integer;",
          "const",
          "  years: TList = (1957, 1964, 1970, 1972, 1975, 1983, 1985, 1991);",
          "",
          "function Search(var a: TList; x: integer): integer;",
          "var",
          "  lo, hi, mid: integer;",
          "begin",
          "  lo := 1;",
          "  hi := 8;",
          "  Search := 0;",
          "  while lo <= hi do",
          "  begin",
          "    mid := (lo + hi) div 2;",
          "    if a[mid] = x then",
          "    begin",
          "      Search := mid;",
          "      exit;",
          "    end",
          "    else if a[mid] < x then",
          "      lo := mid + 1",
          "    else",
          "      hi := mid - 1;",
          "  end;",
          "end;",
          "",
          "begin",
          "  writeln('1983 is at ', Search(years, 1983));",
          "  writeln('1999 is at ', Search(years, 1999));",
          "end."
        ],
        "output": [
          "1983 is at 6",
          "1999 is at 0"
        ]
      },
      "exercises": [
        {
          "id": "p12-l3-e1",
          "type": "multiple_choice",
          "prompt": "What does binary search need?",
          "options": [
