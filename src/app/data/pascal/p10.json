            "  for r := 1 to 3 do",
            "    for c := 1 to 3 do",
            "      t[r, c] := r * c;",
            "  writeln(t[2, 3]);",
            "end."
          ],
          "options": [
            "6",
            "5",
            "9",
            "3"
          ],
          "answer": 0,
          "explanation": "t[2, 3] is 2 × 3."
        },
        {
          "id": "p10-l3-e5",
          "type": "multiple_choice",
          "prompt": "What does array['a'..'z'] of integer give you?",
          "options": [
            "26 counters, one for each small letter",
            "A string",
            "One counter",
            "An error"
          ],
          "answer": 0,
          "explanation": "The index type can be a range of characters."
        },
        {
          "id": "p10-l3-e6",
          "type": "find_bug",
          "prompt": "This program stops with a range check error. Which line is wrong?",
          "code": [
            "program Grid;",
            "var",
            "  g: array[1..3, 1..2] of integer;",
            "  r, c: integer;",
            "begin",
            "  for r := 1 to 3 do",
            "    for c := 1 to 3 do",
            "      g[r, c] := 0;",
            "end."
          ],
          "answer": 6,
          "explanation": "The second index only goes from 1 to 2."
        }
      ]
    }
  ]
}
