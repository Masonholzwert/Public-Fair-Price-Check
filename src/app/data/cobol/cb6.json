        }
      ]
    },
    {
      "id": "cb6-l3",
      "title": "Group Moves",
      "xp": 15,
      "intro": [
        "MOVE between groups copies the characters one by one, without looking at the fields inside. That's handy for copying a whole record.",
        "But it's also a trap: moving text into a group that has PIC 9 fields puts letters where digits belong, and the next calculation abends with S0C7.",
        "INITIALIZE is the safe way to clear a record: it sets every PIC 9 field to zero and every text field to spaces."
      ],
      "example": {
        "code": [
          "       IDENTIFICATION DIVISION.",
          "       PROGRAM-ID. COPY.",
          "       DATA DIVISION.",
          "       WORKING-STORAGE SECTION.",
          "       01 OLD-REC.",
          "          05 P-NAME PIC X(8).",
          "          05 P-AGE  PIC 99.",
          "       01 NEW-REC.",
          "          05 P-NAME PIC X(8).",
          "          05 P-AGE  PIC 99.",
          "       PROCEDURE DIVISION.",
          "           MOVE \"LOVELACE\" TO P-NAME OF OLD-REC.",
          "           MOVE 36 TO P-AGE OF OLD-REC.",
          "           MOVE OLD-REC TO NEW-REC.",
          "           DISPLAY \"COPY:  \" P-NAME OF NEW-REC \" \" P-AGE OF NEW-REC.",
          "           INITIALIZE NEW-REC.",
          "           DISPLAY \"CLEAR: [\" P-NAME OF NEW-REC \"] \" P-AGE OF NEW-REC.",
          "           STOP RUN."
        ],
        "output": [
          "COPY:  LOVELACE 36",
          "CLEAR: [        ] 00"
        ]
      },
      "exercises": [
        {
          "id": "cb6-l3-e1",
          "type": "multiple_choice",
          "prompt": "What does MOVE between two groups do?",
          "options": [
            "Copies the characters one by one, ignoring the fields inside",
            "Converts every field",
            "Only moves the first field",
            "Nothing"
          ],
          "answer": 0,
          "explanation": "A group is just a row of characters."
        },
        {
          "id": "cb6-l3-e2",
          "type": "multiple_choice",
          "prompt": "What does INITIALIZE do to a record?",
          "options": [
            "Sets numbers to zero and text to spaces",
            "Deletes it",
            "Fills it with spaces",
            "Gives it its VALUEs again"
          ],
          "answer": 0,
          "explanation": "Each field gets the right kind of empty."
        },
        {
          "id": "cb6-l3-e3",
          "type": "multiple_choice",
          "prompt": "Two records both have a field P-AGE. How do you say which one?",
          "options": [
            "P-AGE OF NEW-REC",
            "NEW-REC.P-AGE",
            "NEW-REC(P-AGE)",
            "P-AGE-2"
          ],
          "answer": 0,
          "explanation": "OF (or IN) says which group it belongs to."
        },
        {
          "id": "cb6-l3-e4",
          "type": "find_bug",
          "prompt": "This job abends with S0C7. Which line is the cause?",
          "code": [
            "       IDENTIFICATION DIVISION.",
            "       PROGRAM-ID. TRAP.",
            "       DATA DIVISION.",
            "       WORKING-STORAGE SECTION.",
            "       01 ITEM-REC.",
            "          05 QTY PIC 99.",
            "       PROCEDURE DIVISION.",
            "           MOVE SPACES TO ITEM-REC.",
            "           ADD 1 TO QTY.",
            "           STOP RUN."
          ],
          "answer": 7,
          "explanation": "MOVE SPACES to the group puts spaces into QTY. Use INITIALIZE ITEM-REC, which puts a zero there."
        },
        {
          "id": "cb6-l3-e5",
          "type": "fill_blank",
          "prompt": "Clear the record safely.",
          "code": [
            "           ___ ORDER-REC."
          ],
          "options": [
            "INITIALIZE",
            "CLEAR",
            "MOVE SPACES TO",
            "RESET"
          ],
          "answer": "INITIALIZE",
          "explanation": "INITIALIZE knows which fields are numbers."
        },
        {
          "id": "cb6-l3-e6",
          "type": "multiple_choice",
