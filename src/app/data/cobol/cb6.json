          "code": [
            "       IDENTIFICATION DIVISION.",
            "       PROGRAM-ID. INIT.",
            "       DATA DIVISION.",
            "       WORKING-STORAGE SECTION.",
            "       01 REC.",
            "          05 T PIC X(3).",
            "          05 N PIC 99.",
            "       PROCEDURE DIVISION.",
