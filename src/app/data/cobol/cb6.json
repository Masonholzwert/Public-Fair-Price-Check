        {
          "id": "cb6-l2-e6",
          "type": "order_lines",
          "prompt": "Build a line: a label, then an edited amount.",
          "lines": [
            "       01 TOTAL-LINE.",
            "          05 FILLER    PIC X(8) VALUE \"AMOUNT: \".",
            "          05 TL-AMOUNT PIC $$$9.99."
          ],
          "answer": [
            "       01 TOTAL-LINE.",
            "          05 FILLER    PIC X(8) VALUE \"AMOUNT: \".",
