          "explanation": "FILLER is the nameless field."
        },
        {
          "id": "cb6-l2-e4",
          "type": "multiple_choice",
          "prompt": "Why does everything line up in columns?",
          "options": [
            "Every field has a fixed size",
            "COBOL counts the spaces",
            "DISPLAY adds tabs",
            "It doesn't"
          ],
          "answer": 0,
          "explanation": "The same layout, refilled for each row."
        },
        {
          "id": "cb6-l2-e5",
          "type": "multiple_choice",
          "prompt": "Can a program MOVE something into a FILLER?",
          "options": [
            "No, it has no name to refer to",
            "Yes, MOVE X TO FILLER",
