  "lessons": [
    {
      "id": "cb8-l1",
      "title": "Formulas",
      "xp": 15,
      "intro": [
        "For anything longer than one step, COMPUTE takes a formula: COMPUTE AREA = WIDTH * HEIGHT. It knows + - * / and ** for powers, with * and / before + and -, and brackets.",
        "The spaces around the signs are a must: in COBOL, A-B is a single name (like TOTAL-PRICE), and only A - B is a subtraction.",
        "COMPUTE can round too: COMPUTE X ROUNDED = …, and it has ON SIZE ERROR like the other verbs."
      ],
      "example": {
        "code": [
          "       IDENTIFICATION DIVISION.",
          "       PROGRAM-ID. AREA.",
          "       DATA DIVISION.",
          "       WORKING-STORAGE SECTION.",
          "       01 LEN    PIC 99   VALUE 12.",
          "       01 WID    PIC 99   VALUE 5.",
          "       01 AREA   PIC 9(4).",
          "       PROCEDURE DIVISION.",
          "           COMPUTE AREA = LEN * WID.",
          "           DISPLAY \"AREA:  \" AREA.",
          "           COMPUTE AREA = (LEN + WID) * 2.",
          "           DISPLAY \"EDGE:  \" AREA.",
          "           COMPUTE AREA = LEN ** 2.",
          "           DISPLAY \"LEN²:  \" AREA.",
          "           STOP RUN."
        ],
        "output": [
          "AREA:  0060",
          "EDGE:  0034",
          "LEN²:  0144"
        ]
      },
      "exercises": [
