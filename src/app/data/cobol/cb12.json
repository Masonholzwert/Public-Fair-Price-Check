          ],
          "answer": "REPLACING",
          "explanation": "INSPECT … REPLACING ALL … BY …."
        },
        {
          "id": "cb12-l3-e4",
          "type": "multiple_choice",
          "prompt": "Why set the counter to zero before INSPECT TALLYING?",
          "options": [
            "TALLYING adds to what's already there",
            "INSPECT needs an empty field",
            "It doesn't matter",
            "To avoid S0C4"
          ],
          "answer": 0,
          "explanation": "It counts up from the old value."
        },
        {
          "id": "cb12-l3-e5",
          "type": "multiple_choice",
          "prompt": "What does this job show?",
          "code": [
            "       IDENTIFICATION DIVISION.",
            "       PROGRAM-ID. STR.",
            "       DATA DIVISION.",
            "       WORKING-STORAGE SECTION.",
            "       01 X PIC X(4) VALUE \"AB\".",
            "       01 Y PIC X(4) VALUE \"CD\".",
            "       01 Z PIC X(5) VALUE SPACES.",
            "       PROCEDURE DIVISION.",
            "           STRING X DELIMITED BY SPACE \"-\" DELIMITED BY SIZE",
            "               Y DELIMITED BY SPACE INTO Z",
            "           END-STRING.",
            "           DISPLAY \"[\" Z \"]\".",
            "           STOP RUN."
          ],
          "options": [
            "[AB-CD]",
            "[AB CD]",
            "[ABCD]",
            "[AB-]"
          ],
          "answer": 0,
          "explanation": "Both fields are taken up to their first space, with the hyphen between them."
        },
        {
          "id": "cb12-l3-e6",
