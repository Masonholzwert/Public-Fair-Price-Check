        },
        {
          "id": "cb12-l3-e3",
          "type": "fill_blank",
          "prompt": "Swap every comma for a semicolon.",
          "code": [
            "           INSPECT CSV-LINE ___ ALL \",\" BY \";\"."
          ],
          "options": [
            "REPLACING",
