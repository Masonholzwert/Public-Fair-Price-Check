    {
      "id": "cb7-l2",
      "title": "DIVIDE",
      "xp": 15,
      "intro": [
        "DIVIDE comes in two forms. DIVIDE 4 INTO TOTAL GIVING SHARE is TOTAL ÷ 4. DIVIDE TOTAL BY 4 GIVING SHARE is the same thing, written the other way round.",
        "The result is cut to the size of the field: 17 ÷ 5 into a PIC 99 field is 3, not 3.4. REMAINDER keeps what's left over: 17 ÷ 5 is 3, remainder 2.",
        "Dividing by zero abends the job with S0CB."
      ],
      "example": {
        "code": [
          "       IDENTIFICATION DIVISION.",
          "       PROGRAM-ID. SPLIT.",
          "       DATA DIVISION.",
          "       WORKING-STORAGE SECTION.",
          "       01 BILL       PIC 9(3)V99 VALUE 86.40.",
          "       01 PEOPLE     PIC 9       VALUE 4.",
          "       01 SHARE      PIC 9(3)V99.",
          "       01 BOXES      PIC 99.",
          "       01 LEFT-OVER  PIC 9.",
          "       PROCEDURE DIVISION.",
          "           DIVIDE BILL BY PEOPLE GIVING SHARE.",
          "           DISPLAY \"EACH PAYS \" SHARE.",
          "           DIVIDE 7 INTO 100 GIVING BOXES REMAINDER LEFT-OVER.",
          "           DISPLAY \"100 EGGS: \" BOXES \" BOXES OF 7, \" LEFT-OVER \" LEFT\".",
          "           STOP RUN."
        ],
        "output": [
          "EACH PAYS 02160",
          "100 EGGS: 14 BOXES OF 7, 2 LEFT"
        ]
      },
