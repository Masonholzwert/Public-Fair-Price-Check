{
  "id": "cb13",
  "title": "Files",
  "lessons": [
    {
      "id": "cb13-l1",
      "title": "SELECT and FD",
      "xp": 15,
      "intro": [
        "Real COBOL jobs read and write files. Three places describe a file: SELECT … ASSIGN TO in the ENVIRONMENT DIVISION connects the program's file name to a file on the disk; FD in the FILE SECTION describes its records.",
        "OPEN INPUT opens it for reading, READ fills the record with the next line, CLOSE ends the work. The record's fields are cut at fixed columns: number in 1-5, name in 6-17, and so on.",
        "The disk in this app holds three files: CUSTOMERS, SALES and TRANS. The reference shows their columns."
      ],
      "example": {
        "code": [
          "       IDENTIFICATION DIVISION.",
          "       PROGRAM-ID. ONECUST.",
          "       ENVIRONMENT DIVISION.",
          "       INPUT-OUTPUT SECTION.",
          "       FILE-CONTROL.",
          "           SELECT CUST-FILE ASSIGN TO CUSTOMERS.",
          "       DATA DIVISION.",
          "       FILE SECTION.",
          "       FD CUST-FILE.",
          "       01 CUST-REC.",
          "          05 CUST-NO      PIC 9(5).",
          "          05 CUST-NAME    PIC X(12).",
          "          05 CUST-CITY    PIC X(10).",
          "          05 CUST-BAL     PIC 9(5)V99.",
          "       PROCEDURE DIVISION.",
          "           OPEN INPUT CUST-FILE.",
          "           READ CUST-FILE.",
          "           DISPLAY \"FIRST CUSTOMER: \" CUST-NAME.",
          "           DISPLAY \"CITY:  \" CUST-CITY.",
          "           DISPLAY \"NUMBER: \" CUST-NO.",
          "           CLOSE CUST-FILE.",
          "           STOP RUN."
        ],
        "output": [
          "FIRST CUSTOMER: GRACE HOPPER",
          "CITY:  NEW YORK  ",
          "NUMBER: 00007"
        ]
      },
      "exercises": [
        {
          "id": "cb13-l1-e1",
          "type": "multiple_choice",
          "prompt": "Where does SELECT … ASSIGN TO go?",
          "options": [
            "In the ENVIRONMENT DIVISION, under FILE-CONTROL",
            "In the WORKING-STORAGE SECTION",
            "In the PROCEDURE DIVISION",
            "In the FD"
          ],
          "answer": 0,
          "explanation": "It connects the program to the outside world."
        },
        {
          "id": "cb13-l1-e2",
          "type": "multiple_choice",
          "prompt": "What does the FD describe?",
          "options": [
            "The file's records and their fields",
            "Where the file is on the disk",
            "How fast to read",
            "The printer"
          ],
          "answer": 0,
          "explanation": "File Description."
        },
        {
          "id": "cb13-l1-e3",
          "type": "fill_blank",
          "prompt": "Open the file for reading.",
          "code": [
            "           OPEN ___ CUST-FILE."
          ],
          "options": [
            "INPUT",
            "OUTPUT",
            "READ",
            "FILE"
          ],
          "answer": "INPUT",
          "explanation": "INPUT for reading, OUTPUT for writing."
        },
        {
          "id": "cb13-l1-e4",
          "type": "order_lines",
          "prompt": "Put the work with a file in order.",
          "lines": [
            "           OPEN INPUT CUST-FILE.",
            "           READ CUST-FILE.",
            "           DISPLAY CUST-NAME.",
            "           CLOSE CUST-FILE."
          ],
          "answer": [
            "           OPEN INPUT CUST-FILE.",
            "           READ CUST-FILE.",
            "           DISPLAY CUST-NAME.",
            "           CLOSE CUST-FILE."
          ],
          "explanation": "Open, read, use, close."
        },
        {
          "id": "cb13-l1-e5",
          "type": "find_bug",
          "prompt": "This job stops with an error. Which line is wrong?",
          "code": [
            "       IDENTIFICATION DIVISION.",
            "       PROGRAM-ID. NOOPEN.",
            "       ENVIRONMENT DIVISION.",
            "       INPUT-OUTPUT SECTION.",
            "       FILE-CONTROL.",
            "           SELECT CUST-FILE ASSIGN TO CUSTOMERS.",
            "       DATA DIVISION.",
            "       FILE SECTION.",
            "       FD CUST-FILE.",
            "       01 CUST-REC.",
            "          05 CUST-NO      PIC 9(5).",
            "          05 CUST-NAME    PIC X(12).",
            "          05 CUST-CITY    PIC X(10).",
            "          05 CUST-BAL     PIC 9(5)V99.",
