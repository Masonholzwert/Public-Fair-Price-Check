        },
        {
          "id": "cb11-l2-e4",
          "type": "multiple_choice",
          "prompt": "Inside an inline PERFORM, are periods allowed after the statements?",
          "options": [
            "No: a period would end the PERFORM too early",
            "Yes, after each one",
            "Only after the last",
            "Periods are needed"
