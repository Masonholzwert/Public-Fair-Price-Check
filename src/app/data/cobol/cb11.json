    {
      "id": "cb11-l2",
      "title": "Inline PERFORM",
      "xp": 15,
      "intro": [
        "A loop doesn't need its own paragraph: PERFORM VARYING … END-PERFORM keeps short loops right where they're used.",
        "COBOL programmers still use paragraphs for longer jobs, so each part has a name. Inline loops are for a few lines.",
        "The example prints a loan: 1,000 dollars, 100 paid back each month, plus 1 % interest on what's left."
      ],
      "example": {
        "code": [
          "       IDENTIFICATION DIVISION.",
          "       PROGRAM-ID. LOAN.",
          "       DATA DIVISION.",
          "       WORKING-STORAGE SECTION.",
          "       01 MONTH-NO    PIC 99.",
          "       01 BALANCE     PIC 9(5)V99 VALUE 1000.",
          "       01 LINE-OUT.",
          "          05 L-MONTH   PIC Z9.",
          "          05 L-BAL     PIC $$$,$$9.99.",
          "       PROCEDURE DIVISION.",
          "           PERFORM VARYING MONTH-NO FROM 1 BY 1 UNTIL MONTH-NO > 4",
          "               COMPUTE BALANCE ROUNDED = BALANCE * 1.01 - 100",
          "               MOVE MONTH-NO TO L-MONTH",
          "               MOVE BALANCE TO L-BAL",
          "               DISPLAY LINE-OUT",
          "           END-PERFORM.",
          "           STOP RUN."
        ],
        "output": [
          " 1   $910.00",
          " 2   $819.10",
          " 3   $727.29",
          " 4   $634.56"
        ]
      },
      "exercises": [
        {
          "id": "cb11-l2-e1",
          "type": "multiple_choice",
          "prompt": "What does an inline PERFORM need at its end?",
          "options": [
            "END-PERFORM",
            "A paragraph name",
            "STOP RUN",
            "Nothing"
          ],
          "answer": 0,
          "explanation": "The statements go between PERFORM and END-PERFORM."
        },
        {
          "id": "cb11-l2-e2",
          "type": "multiple_choice",
          "prompt": "What does this job show?",
          "code": [
            "       IDENTIFICATION DIVISION.",
            "       PROGRAM-ID. EVEN.",
            "       DATA DIVISION.",
            "       WORKING-STORAGE SECTION.",
            "       01 I PIC 9.",
            "       PROCEDURE DIVISION.",
            "           PERFORM VARYING I FROM 2 BY 2 UNTIL I > 6",
            "               DISPLAY I \" \" WITH NO ADVANCING",
            "           END-PERFORM.",
            "           DISPLAY \"END\".",
            "           STOP RUN."
          ],
          "options": [
            "2 4 6 END",
            "1 2 3 END",
            "2 4 6 8 END",
            "6 END"
          ],
          "answer": 0,
          "explanation": "I = 2, 4, 6. Each DISPLAY stays on the line, without advancing."
        },
