            "       WORKING-STORAGE SECTION.",
            "       01 PI-VALUE PIC 9V99 VALUE 3.14159.",
            "       PROCEDURE DIVISION.",
            "           DISPLAY PI-VALUE.",
            "           STOP RUN."
          ],
          "answer": 4,
          "explanation": "3.14159 has 5 decimals, but PIC 9V99 has room for 2. Use VALUE 3.14."
        },
        {
          "id": "cb4-l1-e6",
          "type": "multiple_choice",
          "prompt": "MOVE 2.999 TO a PIC 9V99 field. What does it hold?",
          "options": [
            "2.99",
            "3.00",
            "2.999",
            "an error"
          ],
          "answer": 0,
          "explanation": "Extra decimals are cut off, not rounded. (Rounding comes later, with ROUNDED.)"
