{
  "id": "cb5",
  "title": "Editing Pictures",
  "lessons": [
    {
      "id": "cb5-l1",
      "title": "Z: No Leading Zeros",
      "xp": 15,
      "intro": [
        "PIC 9 fields are for calculating. For printing, COBOL has edited pictures: you MOVE a number into them, and they make it look right.",
        "Z is a digit that becomes a space when it's a leading zero. PIC ZZZ9 shows 42 as two spaces and 42. The last digit is usually a 9, so zero shows as 0, not as nothing.",
        "Edited fields are only for showing: you can't calculate with them. Keep a PIC 9 field for the math, and MOVE it into the edited one at the end."
      ],
      "example": {
        "code": [
          "       IDENTIFICATION DIVISION.",
          "       PROGRAM-ID. ZEROS.",
          "       DATA DIVISION.",
          "       WORKING-STORAGE SECTION.",
          "       01 COUNTER   PIC 9(4) VALUE 42.",
          "       01 COUNT-OUT PIC ZZZ9.",
          "       PROCEDURE DIVISION.",
          "           MOVE COUNTER TO COUNT-OUT.",
          "           DISPLAY \"[\" COUNTER \"] [\" COUNT-OUT \"]\".",
          "           MOVE ZERO TO COUNT-OUT.",
          "           DISPLAY \"ZERO: [\" COUNT-OUT \"]\".",
          "           STOP RUN."
        ],
        "output": [
          "[0042] [  42]",
          "ZERO: [   0]"
        ]
      },
      "exercises": [
        {
          "id": "cb5-l1-e1",
          "type": "picture",
          "prompt": "The value 42 must print as two spaces and 42. Build the picture.",
          "value": "42",
          "target": "  42",
          "answer": "ZZ99",
          "explanation": "ZZ hides the two leading zeros. ZZZ9 or ZZ99 both work.",
          "keys": [
            "9",
            "Z"
          ]
        },
        {
          "id": "cb5-l1-e2",
          "type": "multiple_choice",
          "prompt": "What does PIC ZZZZ show for the value 0?",
          "options": [
            "Four spaces",
            "0",
            "0000",
            "an error"
          ],
          "answer": 0,
          "explanation": "All Z: a zero becomes nothing at all. That's why the last position is usually a 9."
        },
